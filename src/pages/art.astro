---
import Layout from '../layouts/Layout.astro';
import milosConceptSprites from "../assets/Milos Concept Sprites.jpeg";
import npcConceptArt from "../assets/NPC Concept Art.jpeg";
import {Image} from "astro:assets";
	---
	
<Layout>
	<div id="container">
		<main>
			<section id="art">
				<h3>
					Concept Art:
				</h3>
				<h2>
					Milos Sprite Art:
				</h2>
				<Image class="responsive-img" src={milosConceptSprites} loading="eager" alt="Milos Art" />
				<h2>
					NPC Concept Art:
				</h2>
				<Image class="responsive-img" src={npcConceptArt} loading="eager" alt="NPC Concept Art"/>
			</section>
		</main>
	</div>
	
	<style>
	  * {
	    box-sizing: border-box;
	  }
	
	  #background {
	    position: fixed;
	    top: 0;
	    left: 0;
	    width: 100%;
	    height: 100%;
	    z-index: -1;
	    object-fit: cover;
	  }
	
	  #container {
	    font-family: Inter, Roboto, sans-serif;
	    min-height: 100vh;
	    display: flex;
	    flex-direction: column;
	  }
	
	  main {
	    flex: 1;
	    display: flex;
	    flex-direction: column;
	    align-items: center;
	    width: 100%;
	    margin: 0 auto;
	  }
	
	  #art {
	    display: flex;
	    align-items: center;
	    flex-direction: column;
	    justify-content: center;
	    padding: 16px;
	    text-align: center;
	    width: 100%;
	  }
	
	  #art h2 {
	    font-size: 1.5rem;
	    margin: 1em 0 0.5em;
	  }
	
	  #art h3 {
	    color: #FFFFFF;
	    font-size: 2rem;
	    margin: 0 0 1.5rem;
	  }
	
	  #art h4 {
	    margin: 1.5rem 0 0.5rem;
	  }
	
	  .responsive-img {
	    width: 100%;
	    height: auto;
	    max-width: 410px;
	    display: block;
		border: 8px solid #000000; 
    	border-radius: 8px;
	  }
	</style>
</Layout>
	