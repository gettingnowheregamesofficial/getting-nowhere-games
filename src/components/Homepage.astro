---
import logo from "../assets/Logo.jpeg"
import milosConceptSprites from "../assets/Milos Concept Sprites.jpeg";
import npcConceptArt from "../assets/NPC Concept Art.jpeg";
import background from '../assets/background.svg';
---

<div id="container">
	<img id="background" src={background.src} alt="" fetchpriority="high" />
	<main>
		<section id="nav-bar">
			<img src={logo.src} width="60" height="60" alt="Logo"/>
			<h1>
				Getting Nowhere Games
			</h1>
			<div class="menu">
				<button class="menu-button" id="menuBtn">
					☰
				</button>

				<ul class="menu-items" id="menuItems">
					<li><a href="#info">Info</a></li>
    				<li><a href="#art">Art</a></li>
    				<li><a href="#support">Support</a></li>
    				<li><a href="#wishlist">Wishlist</a></li>
				</ul>
			</div>
		</section>
		<section id="hero">
			<h2>
				Presented by Getting Nowhere Games:
			</h2>
			<h3>
				Sightless Star!
			</h3>
			<h4>
				Milos Sprite Art:
			</h4>
			<img src={milosConceptSprites.src} width="410" height="320" alt="Milos Art" />
			<h4>
				NPC Concept Art:
			</h4>
			<img src={npcConceptArt.src} width="410" height="220" alt="NPC Concept Art"/>
		</section>

		<section id="links">
			<a href="https://discord.com"> Join the Discord</a>
		</section>
	</main>
</div>

<style>
	#background {
		position: fixed;
		top: 0;
		left: 0;
		width: 100%;
		height: 100%;
		z-index: -1;
		filter: blur(0px);
	}

	#container {
		font-family: Inter, Roboto, 'Helvetica Neue', 'Arial Nova', 'Nimbus Sans', Arial, sans-serif;
		height: 100%;
	}

	main {
		display: flex;
		flex-direction: column;
		align-items: center;
		padding-top: 75px;
	}

	#nav-bar {
		position: absolute;
		top: 0;
		left: 0;
		right: 0;
		width: 100%;
		height: 70px;
		background-color:coral;
		display: flex;
		z-index: 1000;
		border-bottom:5px solid #000000;
	}

	#nav-bar img {
		margin-left: 5px;
		margin-right: 5px;
		margin-top: 5px;
	}

	#nav-bar h1 {
		margin-top: 15px;
		margin-left: 30px;
	}

	.menu {
		position: relative;
		display: inline-block;
		margin-left: auto;
		margin-right: 20px;
		margin-top: -10px;
	}

	.menu-button {
		background-color: transparent;
		color: #000000;
		right: 0;
		border: none;
		cursor: pointer;
		font-size: 60px;
	}

	.menu-items {
		display: none;
		position: absolute;
		top: 100%;
		right: -18px;
		padding: 0;
		margin: 0;
		list-style: none;
		background-color: white;
		border: 3px solid #000000;
		min-width: max-content;
	}

	.menu-items li {
		width: 100%;
		font-size: 200%;
		text-align: left;
		margin-left: 5px;
		margin-right: 5px;
	}

	.menu-items a {
		text-align: left;
		display: block;
	}

	.menu-items.show {
		display: block;
	}

	#hero {
		display: flex;
		align-items: start;
		flex-direction: column;
		justify-content: center;
		padding: 16px;
	}

	#hero h2 {
		position: relative;
		top: 10px;
		font-size: 22px;
		margin-top: 0.25em;
	}

	#hero h3 {
		align-self: center;
		color: yellowgreen;
	}

	#hero img {
		margin-top: 10px;
	}

	#links {
		display: flex;
		gap: 16px;
	}

	#links a {
		display: flex;
		align-items: center;
		position: fixed;
		bottom: 20px;
		left: 20px;
		padding: 10px 12px;
		color:#3245ff;
		text-decoration: none;
		transition: color 0.2s;
	}

	#links a:hover {
		color:#bc52ee;
	}

	#links a svg {
		height: 1em;
		margin-left: 8px;
	}

	#links a.button {
		color: white;
		background: linear-gradient(83.21deg, #3245ff 0%, #bc52ee 100%);
		box-shadow:
			inset 0 0 0 1px rgba(255, 255, 255, 0.12),
			inset 0 -2px 0 rgba(0, 0, 0, 0.24);
		border-radius: 10px;
	}

	#links a.button:hover {
		color: rgb(230, 230, 230);
		box-shadow: none;
	}

	pre {
		font-family:
			ui-monospace, 'Cascadia Code', 'Source Code Pro', Menlo, Consolas, 'DejaVu Sans Mono',
			monospace;
		font-weight: normal;
		background: linear-gradient(14deg, #d83333 0%, #f041ff 100%);
		-webkit-background-clip: text;
		-webkit-text-fill-color: transparent;
		background-clip: text;
		margin: 0;
	}

	h2 {
		margin: 0 0 1em;
		font-weight: normal;
		color: #111827;
		font-size: 20px;
	}

	p {
		color: #4b5563;
		font-size: 16px;
		line-height: 24px;
		letter-spacing: -0.006em;
		margin: 0;
	}

	.box {
		padding: 16px;
		background: rgba(255, 255, 255, 1);
		border-radius: 16px;
		border: 1px solid white;
	}

	@media screen and (max-height: 368px) {
		#news {
			display: none;
		}
	}

	@media screen and (max-width: 768px) {
		#container {
			display: flex;
			flex-direction: column;
		}

		#hero {
			display: block;
			padding-top: 10%;
		}

		#links {
			flex-wrap: wrap;
		}

		#links a.button {
			padding: 14px 18px;
		}

		h1 {
			line-height: 1.5;
		}
	}
</style>

<script>
	const btn = document.getElementById('menuBtn');
	const menu = document.getElementById('menuItems');

	// 1. Toggle menu when clicking the button itself
	btn?.addEventListener('click', (event) => {
		event.stopPropagation(); // Stops click from triggering the window listener below
		menu?.classList.toggle('show');
  	});

	// 2. Close the menu when clicking ANYWHERE outside of it
  	window.addEventListener('click', (event) => {
    	const target = event.target as HTMLElement;
    
    	// If the click is outside the menu and outside the button, close it
    	if (menu && !menu.contains(target) && target !== btn) {
    	  menu.classList.remove('show');
    	}
  	});
</script>
