---
import logo from "../assets/Logo.jpeg"
import milosConceptSprites from "../assets/Milos Concept Sprites.jpeg";
import npcConceptArt from "../assets/NPC Concept Art.jpeg";
import discordLogo from "../assets/Discord.png"
import background from '../assets/background.png';
import Image from "astro/components/Image.astro";
---

<div id="container">
	<img id="background" src={background.src} alt="" fetchpriority="high" />
	<main>
		<section id="nav-bar">

			<div class="nav-left">
				<img src={logo.src} width="45" height="45" alt="Logo"/>
				<h1>
					Getting Nowhere Games
				</h1>
			</div>

			<div class="menu">
				<button class="menu-button" id="menuBtn">
					☰
				</button>

				<ul class="menu-items" id="menuItems">
					<li><a href="#info">Info</a></li>
    				<li><a href="#art">Art</a></li>
    				<li><a href="#support">Support</a></li>
    				<li><a href="#wishlist">Wishlist</a></li>
				</ul>
			</div>

		</section>

		<section id="hero">
			<h2>
				Presented by Getting Nowhere Games:
			</h2>
			<h3>
				Sightless Star!
			</h3>
			<h4>
				Milos Sprite Art:
			</h4>
			<Image class="responsive-img" src={milosConceptSprites} alt="Milos Art" />
			<h4>
				NPC Concept Art:
			</h4>
			<Image class="responsive-img" src={npcConceptArt} alt="NPC Concept Art"/>
		</section>

		<section id="links">
			<a href="https://discord.gg/SZVaYVU6D" target="_blank">
				<Image src={discordLogo} width="60" height="60" alt="Discord Link"/>
			</a>
		</section>
	</main>
</div>

<style>
  * {
    box-sizing: border-box;
  }

  #background {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: -1;
    object-fit: cover;
  }

  #container {
    font-family: Inter, Roboto, sans-serif;
    min-height: 100vh;
    display: flex;
    flex-direction: column;
  }

  main {
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 24px 16px;
    width: 100%;
    max-width: 800px;
    margin: 0 auto;
  }

  #nav-bar {
    position: sticky;
    top: 0;
    width: 100%;
    background-color: coral;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 10px 16px;
    z-index: 1000;
    border-bottom: 5px solid #000000;
  }

  .nav-left {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  #nav-bar h1 {
    font-size: 1.25rem;
    margin: 0;
    white-space: nowrap;
  }

  .menu {
    position: relative;
    display: flex;
    align-items: center;
  }

  .menu-button {
    background-color: transparent;
    color: #000000;
    border: none;
    cursor: pointer;
    font-size: 2rem;
    padding: 0;
    line-height: 1;
    display: block;
  }

  .menu-items {
    display: none;
    position: absolute;
    top: 140%;
    right: 0;
    padding: 8px 0;
    margin: 0;
    list-style: none;
    background-color: white;
    border: 3px solid #000000;
    min-width: 160px;
    box-shadow: 0px 4px 12px rgba(0,0,0,0.15);
  }

  .menu-items.show {
    display: block;
  }

  .menu-items li {
    width: 100%;
    margin: 0;
  }

  .menu-items a {
    display: block;
    padding: 10px 20px;
    color: black;
    text-decoration: none;
    font-size: 1.1rem;
    text-align: left;
  }

  .menu-items a:hover {
    background-color: #f0f0f0;
  }

  #hero {
    display: flex;
    align-items: center;
    flex-direction: column;
    justify-content: center;
    padding: 16px;
    text-align: center;
    width: 100%;
  }

  #hero h2 {
    font-size: 1.5rem;
    margin: 1em 0 0.5em;
  }

  #hero h3 {
    color: yellowgreen;
    font-size: 2rem;
    margin: 0 0 1.5rem;
  }

  #hero h4 {
    margin: 1.5rem 0 0.5rem;
  }

  .responsive-img {
    width: 100%;
    height: auto;
    max-width: 410px;
    display: block;
    border-radius: 8px;
  }

  #links {
    position: fixed;
    bottom: 20px;
    left: 20px;
    z-index: 999;
  }

  #links a {
    display: flex;
    align-items: center;
    transition: transform 0.2s;
  }

  #links a:hover {
    transform: scale(1.1);
  }

  @media screen and (min-width: 768px) {
    #nav-bar h1 {
      font-size: 1.75rem;
    }

    .menu-button {
      display: none;
    }

    .menu-items {
      display: flex !important;
      position: static;
      border: none;
      background: transparent;
      box-shadow: none;
      padding: 0;
    }

    .menu-items li a {
      color: black;
      font-weight: bold;
      padding: 5px 12px;
    }

    .menu-items li a:hover {
      background: transparent;
      text-decoration: underline;
    }
  }
</style>


<script>
	const btn = document.getElementById('menuBtn');
	const menu = document.getElementById('menuItems');

	// 1. Toggle menu when clicking the button itself
	btn?.addEventListener('click', (event) => {
		event.stopPropagation(); // Stops click from triggering the window listener below
		menu?.classList.toggle('show');
  	});

	// 2. Close the menu when clicking ANYWHERE outside of it
  	window.addEventListener('click', (event) => {
    	const target = event.target as HTMLElement;
    
    	// If the click is outside the menu and outside the button, close it
    	if (menu && !menu.contains(target) && target !== btn) {
    	  menu.classList.remove('show');
    	}
  	});
</script>
