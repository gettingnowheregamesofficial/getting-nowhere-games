---
import discordLogo from "../assets/Discord.png"
import instaLogo from "../assets/Instagram.png";
import redditLogo from "../assets/Reddit.png";
import {Image} from "astro:assets";
---

<section id="links">
	<a href="https://discord.gg/SZVaYVU6D" target="_blank">
		<Image src={discordLogo} width="60" height="60" loading="eager" alt="Discord Link"/>
	</a>

    <a href="https://www.instagram.com/gettingnowheregames/">
        <Image src={instaLogo} width="60" height="60" loading="eager" alt="Instagram Link"/>
    </a>

    <a href="https://www.reddit.com/r/SightlessStar/">
        <Image src={redditLogo} width="60" height="60" loading="eager" alt="Reddit Link"/>
    </a>
</section>

<style>
    #links {
	    position: fixed;
	    bottom: 20px;
	    left: 30px;
	    z-index: 999;
        display: flex;
        gap: 30px;
	  }
	
	  #links a {
	    display: flex;
	    align-items: center;
	    transition: transform 0.2s;
	  }
	
	  #links a:hover {
	    transform: scale(1.1);
	  }
</style>