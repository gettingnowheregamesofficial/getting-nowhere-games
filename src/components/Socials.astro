---
import discordLogo from "../assets/Discord.png"
import {Image} from "astro:assets";
---

<section id="links">
	<a href="https://discord.gg/SZVaYVU6D" target="_blank">
		<Image src={discordLogo} width="60" height="60" alt="Discord Link"/>
	</a>
</section>

<style>
    #links {
	    position: fixed;
	    bottom: 20px;
	    left: 20px;
	    z-index: 999;
	  }
	
	  #links a {
	    display: flex;
	    align-items: center;
	    transition: transform 0.2s;
	  }
	
	  #links a:hover {
	    transform: scale(1.1);
	  }
</style>